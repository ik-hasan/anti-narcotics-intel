# Template only -- copy to backend/.env and fill in real values there.
# .env is gitignored; THIS file is tracked, so never put live keys in it.

# ---- Neo4j AuraDB Free ----
# Aura Free: 200k nodes / 400k relationships, vector index supported.
# Instance auto-pauses when idle -- resume it from the console before a demo.
# Paste these straight from the credentials file Aura makes you download at
# instance creation; NEO4J_USERNAME is accepted as an alias for NEO4J_USER.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- LLM provider: groq | gemini ----
# Both are hosted APIs, so no model weights are stored or loaded on Render.
LLM_PROVIDER=groq

# Groq (Llama). Free key from https://console.groq.com/keys
# Confirm the model is callable with: python -m scripts.test_extraction
GROQ_API_KEY=
# Verified working: llama-3.3-70b-versatile, openai/gpt-oss-120b, openai/gpt-oss-20b.
# Do NOT use llama-3.1-8b-instant: it echoes the schema back instead of extracting.
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini kept as a fallback provider only; unused while LLM_PROVIDER=groq.
# Note: Workspace/Education accounts are often blocked at project level and return
# 403 PERMISSION_DENIED on generate even though the key lists models fine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Voyage embeddings (Phase 2) ----
# voyage-4-lite carries the 200M free-token allowance; voyage-3.x has none.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
VOYAGE_DIM=1024
# With a payment method on file the account limit is 2000 RPM / 16M TPM.
# Without one it is 3 RPM / 10k TPM -- lower these if you remove the card.
VOYAGE_RPM=2000
VOYAGE_TPM=1000000

# ---- Search layer (Phase 4) ----
SEARXNG_URL=http://127.0.0.1:8888
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
SEARCH_PROVIDER_ORDER=searxng,duckduckgo,google_cse

# ---- Crawler (Phase 4) ----
# Scrapy runs as an isolated subprocess. If it is missing or fails, httpx+trafilatura is used.
CRAWLER_BACKEND=scrapy
MAX_URLS_PER_QUERY=15
CRAWL_TIME_BUDGET_SECONDS=120

# ---- Retrieval policy (matches the pitch deck defaults) ----
TOP_K=100
SIMILARITY_GATE=0.80
MIN_HIGH_CONF_CHUNKS=10
FINAL_TOP_N=15
GRAPH_MAX_HOPS=3

# ---- App ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# ---- Auth (JWT) ----
# Use a long random string. Signup OTP is emailed when SMTP_* is set;
# otherwise the code is printed in the API log (local/dev only).
JWT_SECRET=
JWT_EXPIRE_HOURS=24
OTP_EXPIRE_MINUTES=10
# Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Narco-Graph Intel <your-gmail@gmail.com>
